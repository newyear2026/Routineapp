<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 루틴 알림은 사용자가 정한 시각에 울려야 한다. 이 권한이 없으면 OS 가
         알림을 최대 10분 이상 미룬다.

         USE_EXACT_ALARM 은 설치할 때 자동으로 허용되고 사용자가 끌 수 없다.
         Android 14 부터 SCHEDULE_EXACT_ALARM 이 기본 «거부»로 바뀌어서, 그것만
         선언하면 신규 사용자 대부분이 몇 분 늦는 알림을 받는 상태로 시작한다.
         정한 시각에 알리는 것이 이 앱의 전부라 그 상태를 기본값으로 둘 수 없다.

         Play 정책상 이 권한은 «핵심 기능이 정해진 시각의 알림»인 앱만 쓸 수
         있고 Play Console 에 용도를 선언해야 한다. docs/PLAY_STORE_RELEASE.md 참고.

         아래 SCHEDULE_EXACT_ALARM 은 USE_EXACT_ALARM 이 없는 Android 12~12L
         (API 31~32) 전용으로 남긴다. 거기서는 사용자가 시스템 설정에서 끌 수
         있고, 꺼져 있으면 앱은 부정확 알람으로 후퇴한다. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- 부팅 완료 브로드캐스트는 이 권한을 선언한 앱에만 전달된다. 아래
         ScheduledNotificationBootReceiver 와 짝이며, 하나만 있으면 리시버가
         영원히 호출되지 않는다 — 빌드도 되고 경고도 없어서 알아채기 어렵다.

         flutter_local_notifications 는 22.3.0 부터 이 권한을 자기 매니페스트에
         선언하지 않는다(VIBRATE, POST_NOTIFICATIONS 만 선언). 예전에는 병합으로
         따라왔으므로, 플러그인을 올릴 때 조용히 사라졌다. 지우지 않는다. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- AdMob 앱 ID. 이 값이 없으면 SDK 초기화 때 앱이 실행 즉시 죽는다.
             테스트/실제 구분은 이 값이 아니라 광고 단위 ID에서 갈린다
             (AdUnitIds 참고) — 여기에는 언제나 실제 앱 ID가 들어간다.
             INTERNET·AD_ID 권한은 google_mobile_ads 매니페스트가 병합한다. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2706404530136726~7407791654" />

        <!-- flutter_local_notifications 는 자기 매니페스트에 권한만 선언하고
             수신기는 앱이 직접 등록하게 한다. 이 선언이 없으면 알람은 정상적으로
             예약·발화되는데 안드로이드가 받을 수신기를 찾지 못해 브로드캐스트를
             조용히 버린다 — 알림이 영영 뜨지 않고 예외도 남지 않는다. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

        <!-- 재부팅·앱 업데이트 후에도 예약을 되살린다. 없으면 기기를 껐다 켤 때마다
             그때까지 잡아 둔 알림이 전부 사라진다. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".RoutineMediumWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/routine_medium_widget_info" />
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
