<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 선택 화면(previewLayout)에서만 쓰는 링 자리표시. 실제 링은 Kotlin이 비트맵으로 그린다. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_surface" />
        </shape>
    </item>
    <item
        android:bottom="18dp"
        android:left="18dp"
        android:right="18dp"
        android:top="18dp">
        <shape android:shape="oval">
            <stroke android:width="5dp" android:color="@color/widget_ring_track" />
        </shape>
    </item>
</layer-list>
