<?xml version="1.0" encoding="utf-8"?>
<!-- Stepped control border, matching AppPixelStyle's two corner steps. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="6dp" android:right="6dp"><shape><solid android:color="#221C42" /></shape></item>
    <item android:left="3dp" android:right="3dp" android:top="3dp" android:bottom="3dp"><shape><solid android:color="#221C42" /></shape></item>
    <item android:top="6dp" android:bottom="6dp"><shape><solid android:color="#221C42" /></shape></item>
    <item android:left="7.5dp" android:right="7.5dp" android:top="1.5dp" android:bottom="1.5dp"><shape><solid android:color="#6744F4" /></shape></item>
    <item android:left="4.5dp" android:right="4.5dp" android:top="4.5dp" android:bottom="4.5dp"><shape><solid android:color="#6744F4" /></shape></item>
    <item android:left="1.5dp" android:right="1.5dp" android:top="7.5dp" android:bottom="7.5dp"><shape><solid android:color="#6744F4" /></shape></item>
</layer-list>
