<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_action_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_medium_bg_cat">
    <ImageView android:id="@+id/widget_action_decor" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_stars" android:scaleType="fitXY" android:alpha="0.22" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/widget_action_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:paddingHorizontal="6dp" android:paddingVertical="3dp" android:background="@drawable/widget_badge_bg" android:textStyle="bold" android:fallbackLineSpacing="false"/>
                    <TextView android:id="@+id/widget_action_range" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="11sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="7dp" android:layout_weight="1" android:fallbackLineSpacing="false"/>
                </LinearLayout>
                <TextView android:id="@+id/widget_action_title" android:layout_width="match_parent" android:layout_height="32dp" android:textSize="24sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" android:textStyle="bold" android:fallbackLineSpacing="false" android:gravity="center_vertical"/>
                <TextView android:id="@+id/widget_action_duration" android:layout_width="match_parent" android:layout_height="40dp" android:textSize="30sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="0dp" android:textStyle="bold" android:fallbackLineSpacing="false" android:gravity="center_vertical"/>
            </LinearLayout>
            <ImageView android:id="@+id/widget_action_pet" android:layout_width="104dp" android:layout_height="104dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_cat"/>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="3dp" android:layout_marginBottom="4dp">
            <FrameLayout android:id="@+id/widget_action_divider" android:layout_width="match_parent" android:layout_height="1dp" android:background="#556A6489"/>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:id="@+id/widget_action_next_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:fallbackLineSpacing="false"/>
                <TextView android:id="@+id/widget_action_next_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" android:textStyle="bold" android:fallbackLineSpacing="false"/>
            </LinearLayout>
            <FrameLayout android:layout_width="120dp" android:layout_height="44dp">
                <TextView android:id="@+id/widget_action_complete" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/widget_complete_bg" android:gravity="center" android:paddingHorizontal="8dp" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fallbackLineSpacing="false"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
