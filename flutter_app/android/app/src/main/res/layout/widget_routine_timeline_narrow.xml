<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_action_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_medium_bg_cat">
    <ImageView android:id="@+id/widget_action_decor" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_stars" android:scaleType="fitXY" android:alpha="0.22" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/widget_action_pet" android:layout_width="50dp" android:layout_height="62dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_cat"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_action_status" android:layout_width="wrap_content" android:layout_height="16dp" android:textSize="9sp" android:includeFontPadding="false" android:fallbackLineSpacing="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:textColor="@color/widget_text_primary" android:background="@drawable/widget_badge_bg" android:paddingHorizontal="6dp" android:textStyle="bold"/>
                <TextView android:id="@+id/widget_action_title" android:layout_width="match_parent" android:layout_height="25dp" android:textSize="22sp" android:includeFontPadding="false" android:fallbackLineSpacing="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:textColor="@color/widget_text_primary" android:layout_marginTop="2dp" android:textStyle="bold"/>
                <TextView android:id="@+id/widget_action_duration" android:layout_width="match_parent" android:layout_height="26dp" android:textSize="20sp" android:includeFontPadding="false" android:fallbackLineSpacing="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:textColor="@color/widget_text_primary" android:layout_marginTop="2dp" android:textStyle="bold"/>
            </LinearLayout>
            <FrameLayout android:layout_width="70dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_gravity="bottom" android:layout_marginBottom="5dp">
                <TextView android:id="@+id/widget_action_complete" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/widget_complete_bg" android:gravity="center" android:paddingHorizontal="5dp" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fallbackLineSpacing="false"/>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/widget_action_divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="6dp" android:background="#556A6489"/>
        <LinearLayout android:id="@+id/widget_timeline_schedule" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="vertical">
            <ImageView android:id="@+id/widget_timeline_track" android:layout_width="match_parent" android:layout_height="16dp" android:scaleType="fitXY" android:contentDescription="@null"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/widget_timeline_item_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="2dp">
                    <TextView android:id="@+id/widget_timeline_time_0" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="13sp" android:includeFontPadding="false" android:fallbackLineSpacing="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:textColor="@color/widget_text_primary" android:textStyle="bold"/>
                    <TextView android:id="@+id/widget_timeline_title_0" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="13sp" android:includeFontPadding="false" android:fallbackLineSpacing="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:textColor="@color/widget_text_primary" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/widget_timeline_item_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="2dp">
                    <TextView android:id="@+id/widget_timeline_time_1" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="13sp" android:includeFontPadding="false" android:fallbackLineSpacing="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:textColor="@color/widget_text_primary" android:textStyle="bold"/>
                    <TextView android:id="@+id/widget_timeline_title_1" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="13sp" android:includeFontPadding="false" android:fallbackLineSpacing="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:textColor="@color/widget_text_primary" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/widget_timeline_item_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="2dp">
                    <TextView android:id="@+id/widget_timeline_time_2" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="13sp" android:includeFontPadding="false" android:fallbackLineSpacing="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:textColor="@color/widget_text_primary" android:textStyle="bold"/>
                    <TextView android:id="@+id/widget_timeline_title_2" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="13sp" android:includeFontPadding="false" android:fallbackLineSpacing="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:textColor="@color/widget_text_primary" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
