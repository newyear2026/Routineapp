<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_action_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_medium_bg_cat">
    <ImageView android:id="@+id/widget_action_decor" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_stars" android:scaleType="fitXY" android:alpha="0.22" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="10dp">
            <TextView android:id="@+id/widget_action_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:paddingHorizontal="6dp" android:paddingVertical="3dp" android:background="@drawable/widget_badge_bg" android:textStyle="bold" android:fallbackLineSpacing="false"/>
            <TextView android:id="@+id/widget_action_title" android:layout_width="match_parent" android:layout_height="32dp" android:textSize="24sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" android:textStyle="bold" android:fallbackLineSpacing="false" android:gravity="center_vertical"/>
            <TextView android:id="@+id/widget_action_range" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="1dp" android:fallbackLineSpacing="false"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp">
                <TextView android:id="@+id/widget_action_complete" android:layout_width="match_parent" android:layout_height="40dp" android:background="@drawable/widget_complete_bg" android:gravity="center" android:paddingHorizontal="8dp" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fallbackLineSpacing="false"/>
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp">
                <FrameLayout android:id="@+id/widget_action_divider" android:layout_width="match_parent" android:layout_height="1dp" android:background="#556A6489"/>
            </FrameLayout>
            <TextView android:id="@+id/widget_action_next_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:fallbackLineSpacing="false"/>
            <TextView android:id="@+id/widget_action_next_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="0dp" android:textStyle="bold" android:fallbackLineSpacing="false"/>
        </LinearLayout>
        <FrameLayout android:layout_width="124dp" android:layout_height="156dp">
            <FrameLayout android:layout_width="124dp" android:layout_height="124dp" android:layout_gravity="bottom|center_horizontal">
                <ImageView android:id="@+id/widget_action_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter"/>
                <LinearLayout android:layout_width="76dp" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView android:id="@+id/widget_action_duration" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="23sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:gravity="center" android:fallbackLineSpacing="false"/>
                    <TextView android:id="@+id/widget_action_duration_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:includeFontPadding="false" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" android:gravity="center" android:fallbackLineSpacing="false"/>
                </LinearLayout>
            </FrameLayout>
            <ImageView android:id="@+id/widget_action_pet" android:layout_width="46dp" android:layout_height="40dp" android:contentDescription="@null" android:scaleType="fitCenter" android:layout_gravity="top|center_horizontal" android:src="@drawable/widget_cat"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
