<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/widget_medium_bg_cat">
    <ImageView android:id="@+id/widget_decor" android:layout_width="match_parent"
        android:layout_height="match_parent" android:contentDescription="@null"
        android:alpha="0.45" android:scaleType="fitXY" android:src="@drawable/widget_stars" />
    <ImageView android:id="@+id/widget_leaf" android:layout_width="18dp"
        android:layout_height="18dp" android:layout_gravity="top|right"
        android:layout_marginTop="12dp" android:layout_marginEnd="12dp"
        android:contentDescription="@null" android:src="@drawable/widget_leaf"
        android:visibility="gone" />
    <ImageView android:id="@+id/widget_daisy" android:layout_width="33dp"
        android:layout_height="33dp" android:layout_gravity="bottom|right"
        android:contentDescription="@null" android:src="@drawable/widget_daisy"
        android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:paddingStart="7dp" android:paddingEnd="7dp"
        android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageView android:id="@+id/widget_mascot" android:layout_width="55dp"
            android:layout_height="64dp" android:layout_gravity="bottom"
            android:contentDescription="@null" android:scaleType="fitCenter"
            android:src="@drawable/widget_cat" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginStart="3dp" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/widget_status_badge" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:background="@drawable/widget_badge_bg"
                android:paddingHorizontal="7dp" android:paddingVertical="2dp"
                android:textColor="@android:color/white" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_current_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:ellipsize="end" android:maxLines="1"
                android:textColor="@color/widget_text_primary" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_timing_hint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:ellipsize="end" android:maxLines="1"
                android:textColor="@color/widget_accent" android:textSize="12sp" android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="8dp" android:background="@color/widget_border" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/widget_next_label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/widget_next_label"
                    android:textColor="@color/widget_text_muted" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_next_title" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_weight="1"
                    android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text_primary"
                    android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_next_time" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="2dp"
                    android:textColor="@color/widget_text_muted" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent"
            android:layout_marginStart="5dp" android:background="@color/widget_border" />
        <FrameLayout android:layout_width="101dp" android:layout_height="101dp"
            android:layout_gravity="center_vertical" android:layout_marginStart="3dp">
            <ImageView android:id="@+id/widget_ring" android:layout_width="match_parent"
                android:layout_height="match_parent" android:contentDescription="@string/widget_medium_description"
                android:scaleType="fitCenter" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:gravity="center" android:orientation="vertical">
                <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:fontFamily="monospace"
                    android:textColor="@color/widget_text_primary" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_now_label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="1dp"
                    android:background="@color/widget_label_surface" android:paddingHorizontal="4dp"
                    android:textColor="@color/widget_text_muted" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
